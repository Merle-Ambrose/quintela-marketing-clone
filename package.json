{
  "name": "company-demo",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "react-scripts": "^5.0.1",
    "web-vitals": "^5.2.0"
  },
  "scripts": {
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,css}\"",
    "prestart": "npm run format:check",
    "prebuild": "npm run format:check",
    "postinstall": "patch-package",
    "start": "react-scripts start",
    "build": "react-scripts build",
    "eject": "react-scripts eject",
    "type-check": "tsc --noEmit"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version",
      "last 1 edge version"
    ]
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "prettier": "^3.8.3",
    "sass": "^1.99.0",
    "sharp": "^0.34.5",
    "typescript": "^4.9.5",
    "typescript-plugin-css-modules": "^5.2.0",
    "vnu-jar": "^26.4.16",
    "patch-package": "^6.5.1"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "overrides": {
    "nth-check": "2.0.1",
    "postcss": "8.5.11",
    "serialize-javascript": "7.0.5",
    "underscore": "1.13.8",
    "uuid": "14.0.0",
    "@tootallnate/once": "3.0.1",
    "bfj": "9.1.3",
    "css-select": "4.1.0",
    "jsdom": "22.1.0",
    "http-proxy-agent": "5.0.0",
    "webpack-dev-server": "5.2.3",
    "sockjs": "0.3.24",
    "tmp": "0.2.5",
    "sass-loader": "13.2.0"
  }
}
